# Copy to .env.local and fill in. Never commit the filled copy.

# --- Database --------------------------------------------------------------
# Neon Postgres. Use the POOLED connection string for the application.
# Must be present at build time too: Next imports the db module while
# collecting page data. No connection is opened during the build.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/forge?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Session signing secret. Generate:
#   npx auth secret
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth 2.0 client. Auth.js reads these two names automatically —
# see docs/AUTH.md for how to create the client in Google Cloud Console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Provider integrations -------------------------------------------------
# GitHub OAuth App. Note these are NOT named AUTH_* — those belong to Auth.js
# and answer "who is this person". These answer "which GitHub account may Forge
# read on their behalf". See docs/INTEGRATIONS.md.
#
# GitHub OAuth App. Created at https://github.com/settings/developers
# Callback: https://forge.harithkavish.com/api/integrations/github/callback
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Vercel Integration (OAuth). Created at https://vercel.com/integrations/console
# with read-only permissions. The slug is the integration's URL name.
VERCEL_OAUTH_CLIENT_ID=""
VERCEL_OAUTH_CLIENT_SECRET=""
VERCEL_INTEGRATION_SLUG=""

# Cloudflare OAuth. Create the client at
# Cloudflare dashboard > Manage Account > OAuth clients, with read-only scopes.
# Redirect URL: https://forge.harithkavish.com/api/integrations/cloudflare/callback
CLOUDFLARE_OAUTH_CLIENT_ID=""
CLOUDFLARE_OAUTH_CLIENT_SECRET=""
# Space-separated, matching the scopes selected on the client. Include
# offline_access so the connection can refresh instead of expiring.
CLOUDFLARE_OAUTH_SCOPES=""

# Neon has OAuth but only for approved commercial partners, so users connect
# with their own API key entered in the app. Nothing to configure here.

# --- Credential encryption -------------------------------------------------
# Required before Forge can store a provider credential.
#
# Keyring for provider secrets, as "version:base64key" entries, newest first.
# The highest version encrypts; older versions must stay listed until every row
# using them has been re-encrypted.
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# Losing these keys means every connected provider account must be reconnected.
FORGE_ENCRYPTION_KEYS=""

# --- Background sync -------------------------------------------------------
# Shared secret required by the cron-triggered sync drain endpoint.
CRON_SECRET=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
