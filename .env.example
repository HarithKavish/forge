# Copy to .env.local and fill in. Never commit the filled copy.

# --- Database --------------------------------------------------------------
# Neon Postgres connection string (use the pooled URL for the app).
DATABASE_URL="postgresql://user:password@host.neon.tech/forge?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Session signing secret. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Credential encryption -------------------------------------------------
# Keyring for provider secrets, as "version:base64key" entries, newest first.
# The highest version encrypts new secrets; older versions must remain listed
# until every row using them has been re-encrypted.
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# Losing these keys means every connected provider account must be reconnected.
FORGE_ENCRYPTION_KEYS=""

# --- Background sync -------------------------------------------------------
# Shared secret required by the cron-triggered sync drain endpoint.
CRON_SECRET=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
